# Servidor de Weekly Alignment & Unblock (npm start)
PORT=8787
# Zona horaria de las fechas/horas compromiso (recordatorios y calendario)
TZ=America/Mexico_City
# Carpeta de datos (db.json, state.json, backups/). Debe ser persistente.
DATA_DIR=./data
# demo = datos de prueba la primera vez · empty = arrancar vacío
SEED=empty
# URL pública, para enlaces en Teams y en el calendario
PUBLIC_URL=https://weekly.socasesores.com.mx

# Inicio de sesión: none | easyauth (Azure App Service Authentication con Microsoft Entra ID)
AUTH_MODE=none
# Solo desarrollo: simula al usuario autenticado
# DEV_USER_EMAIL=dmorales@socasesores.com.mx

# Teams: URL del webhook del flujo de Workflows / Power Automate
TEAMS_WEBHOOK_URL=
TEAMS_AUTO_PUBLISH=true
REMINDERS=true

# Protege los calendarios suscritos (?token=...)
CALENDAR_TOKEN=
