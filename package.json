{
  "name": "weekly-alignment-unblock",
  "private": true,
  "version": "2.0.0",
  "description": "Weekly Alignment & Unblock — herramienta de alineación semanal de la Dirección de Posicionamiento",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build && vite build --ssr server/index.ts --outDir dist-server --emptyOutDir",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
